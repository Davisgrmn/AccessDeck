# ./start.sh creates .env automatically; copying this file is optional.
HOST=127.0.0.1
PORT=3000

# The script manages a private PostgreSQL cluster under .local/ by default.
LOCAL_DATABASE_PORT=54329
# Generated on first start. Do not commit the generated password or .env.
LOCAL_DATABASE_PASSWORD=

# Optional: use an existing PostgreSQL database instead of the private cluster.
# The database must already exist and this user must be able to create tables.
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/accessdeck
